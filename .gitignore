/data/*
!/data/models/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Agents
.idea/
.vscode/
.gemini/
.cursor/
.agents/
.opencode/
/AGENTS.md
*.swp
*.swo
*~

# Local QA scratch (probes, layout-shift dumps, screenshots)
/tmp/

# OS
.DS_Store
Thumbs.db

# Docker
*.log

# Model artifacts (stored in data/)
*.joblib
*.pkl
*.json.model

